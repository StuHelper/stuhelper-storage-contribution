  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "Conditions": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 70368744177664
          },
          "personal_reserve": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 70368744177664
          },
          "until": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "limit_bytes",
          "personal_reserve",
          "until"
        ]
      },
      "Consent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "accepted",
          "version",
          "digest"
        ]
      },
      "Terms": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "version",
          "digest",
          "url"
        ]
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "terms": {
            "$ref": "#/components/schemas/Terms"
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "min_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "min_term_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_term_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "exit_target_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "max_per_owner": {
            "type": "integer"
          },
          "observation_max_age_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "terms",
          "adapters",
          "min_bytes",
          "max_bytes",
          "min_term_seconds",
          "max_term_seconds",
          "exit_target_seconds",
          "max_per_owner",
          "observation_max_age_seconds"
        ]
      },
      "CreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string"
          },
          "conditions": {
            "$ref": "#/components/schemas/Conditions"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          }
        },
        "required": [
          "instance_id",
          "conditions",
          "consent"
        ]
      },
      "CommandRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "exit",
              "revoke",
              "configure",
              "renew",
              "retry"
            ]
          },
          "conditions": {
            "$ref": "#/components/schemas/Conditions"
          },
          "consent": {
            "$ref": "#/components/schemas/Consent"
          }
        },
        "required": [
          "revision",
          "action"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
